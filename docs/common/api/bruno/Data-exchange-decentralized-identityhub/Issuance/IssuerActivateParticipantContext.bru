meta {
  name: IssuerActivateParticipantContext
  type: http
  seq: 2
}

post {
  url: {{ISSUERSERVICE.URL}}/api/identity/v1alpha/participants/{{ISSUER_DID_PARTICIPANT_CONTEXT}}/state?isActive=true
  body: none
  auth: apikey
}

auth:apikey {
  key: x-api-key
  value: {{API-KEY}}
  placement: header
}

vars:pre-request {
  ISSUER_DID_PARTICIPANT_CONTEXT: bWluaWt1YmU=
}

settings {
  encodeUrl: true
  timeout: 0
}
