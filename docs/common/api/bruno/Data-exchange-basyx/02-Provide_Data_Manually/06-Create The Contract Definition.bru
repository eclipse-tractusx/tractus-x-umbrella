meta {
  name: 06-Create The Contract Definition
  type: http
  seq: 6
}

post {
  url: {{Bob}}/contractdefinitions
  body: json
  auth: apikey
}

auth:apikey {
  key: X-Api-Key
  value: {{Bob_Api_Key}}
  placement: header
}

body:json {
  {
    "@context": { "@vocab": "https://w3id.org/edc/v0.0.1/ns/" },
    "@id": "basyx-contract-definition",
    "@type": "ContractDefinition",
    "accessPolicyId": "{{ACCESS_POLICY_ID}}",
    "contractPolicyId": "{{USAGE_POLICY_ID}}",
    "assetsSelector": [
      {
        "@type": "CriterionDto",
        "operandLeft": "https://w3id.org/edc/v0.0.1/ns/id",
        "operator": "in",
        "operandRight": ["{{DTR_ASSET_ID}}", "{{MANUAL_SUBMODEL_ASSET_ID}}"]
      }
    ]
  }
}
