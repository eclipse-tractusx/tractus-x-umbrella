meta {
  name: 03-Query DTR EDR
  type: http
  seq: 3
}

post {
  url: {{Alice}}/edrs/request
  body: json
  auth: apikey
}

headers {
  Content-Type: application/json
}

auth:apikey {
  key: X-Api-Key
  value: {{Alice_Api_Key}}
  placement: header
}

body:json {
  {
    "@context": { "@vocab": "https://w3id.org/edc/v0.0.1/ns/" },
    "@type": "QuerySpec",
    "filterExpression": [
      {
        "operandLeft": "contractNegotiationId",
        "operator": "=",
        "operandRight": "{{DTR_NEGOTIATION_ID}}"
      }
    ]
  }
}

tests {
  // Empty result: the negotiation is still running; wait a few seconds and retry.
  bru.setVar("DTR_TRANSFER_PROCESS_ID", res.body[0].transferProcessId);
}
